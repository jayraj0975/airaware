# Copy to .env and fill in what you use. Every setting is optional unless marked.

# The site's public address, used in link previews and emailed links (e.g. https://air.example.in).
AIRAWARE_PUBLIC_URL=

# Permanent HTTPS address: the token of a Cloudflare named tunnel (Zero Trust > Networks > Tunnels).
# Required only for `docker compose --profile named up -d`. Point the tunnel's public hostname at http://172.30.0.10:8000.
TUNNEL_TOKEN=

# Sign-in cookie over HTTPS only. Keep 1 behind the tunnel; 0 only for plain-HTTP testing on a LAN.
AIRAWARE_SECURE_COOKIES=1

# Live hourly CPCB readings (free key from https://explore.openaq.org). Without it the public archive is used.
OPENAQ_API_KEY=

# Email for alerts and password resets. Without it, alerts appear in the app only.
AIRAWARE_SMTP_HOST=
AIRAWARE_SMTP_PORT=587
AIRAWARE_SMTP_USER=
AIRAWARE_SMTP_PASSWORD=
AIRAWARE_SMTP_FROM=
